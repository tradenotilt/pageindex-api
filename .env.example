# ──────────────────────────────────────────────────
# LLM Provider — выбери один из вариантов:
# ──────────────────────────────────────────────────
#
# Вариант 1: Оригинальный OpenAI
#   LLM_PROVIDER=openai
#   CHATGPT_API_KEY=sk-...                     # для чата и эмбеддингов
#
# Вариант 2: OpenAI-совместимый (OpenCode, DeepSeek, Groq, Llama.cpp и др.)
#   LLM_PROVIDER=openai_compatible
#   LLM_API_KEY=sk-...
#   LLM_BASE_URL=https://opencode.ai/zen/go/v1
#   LLM_CHAT_MODEL=deepseek-v4-flash
#   CHATGPT_API_KEY=sk-...                     # только для эмбеддингов (если нужны)

# OpenAI — ключ для чата (Вариант 1) ИЛИ только для эмбеддингов (Вариант 2)
CHATGPT_API_KEY=

# Провайдер: openai | openai_compatible
LLM_PROVIDER=openai

# Ключ для OpenAI-совместимого провайдера (Вариант 2)
LLM_API_KEY=

# Базовый URL для OpenAI-совместимого провайдера (Вариант 2)
LLM_BASE_URL=

# Модель для чата (используется в /search, /ask_agent, /vision)
LLM_CHAT_MODEL=gpt-4o-mini

# ──────────────────────────────────────────────────
# API protection
# ──────────────────────────────────────────────────
APP_API_KEY=

# ──────────────────────────────────────────────────
# App settings
# ──────────────────────────────────────────────────
MAX_CONCURRENT_TASKS=10
TASK_TIMEOUT=300
MAX_FILE_SIZE=52428800
DATA_DIR=./data
RESULTS_DIR=./results
REGISTRY_FILE=./data/registry.json
TASKS_FILE=./data/tasks.json
PAGEINDEX_SCRIPT=run_pageindex.py
PAGEINDEX_MODEL=gpt-4o-2024-11-20
PAGEINDEX_TOC_CHECK_PAGES=20
PAGEINDEX_PDF_CHUNK_SIZE=1800
PAGEINDEX_PDF_CHUNK_OVERLAP=200
PAGEINDEX_PDF_CHUNK_THRESHOLD=1200
ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.md

# Модель для генерации keywords в document_index (по умолчанию: gpt-4o-2024-11-20)
KEYWORDS_MODEL=gpt-4o-2024-11-20

# Модель для Vision OCR (по умолчанию: gpt-4o-2024-11-20)
VISION_MODEL=gpt-4o-2024-11-20

# Принудительное использование улучшенного парсинга с распознаванием таблиц
FORCE_ENHANCED_PARSING=false
